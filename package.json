{
  "name": "pi-only-tools",
  "version": "0.6.0",
  "description": "Codex-style shell, patch, and standalone web search tools with unified Normal, Ask, and Plan modes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "WEB_SEARCH.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "prepack": "npm run build && npm run check",
    "test:host": "node --test test/host-integration.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "shell-command",
    "apply-patch",
    "web-search",
    "claude-code",
    "coding-agent",
    "ask-mode",
    "plan-mode",
    "tool-profiles"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "typebox": "1.4.6"
  }
}
